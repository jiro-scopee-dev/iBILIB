# Server port
PORT=5000

# SQLite connection string (Prisma). Change to PostgreSQL/MySQL later if needed.
DATABASE_URL="file:./dev.db"

# Directory (relative to backend/) where uploaded files are stored
UPLOAD_DIRECTORY="uploads"

# Allowed browser origins (comma-separated). Add your frontend URL here.
CLIENT_URL="http://localhost:3000,https://i-bilib.vercel.app"

# Storage backend: "local" (disk, default) or "supabase" (Supabase Storage)
STORAGE_BACKEND="local"

# Supabase credentials (only needed when STORAGE_BACKEND="supabase")
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="uploads"
